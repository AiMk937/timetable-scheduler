<%- include('../layout/header') %>

<div class="container mt-5">
  <h2 class="text-center mb-4">Existing Timetables</h2>

  <% if (timetables && timetables.length > 0) { %>
    <% 
      // Sort by creation date (newest first)
      timetables.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt)); 
    %>

    <% timetables.forEach(function(tt) { %>
      <div class="card mb-4 shadow-sm">
        <div class="card-header bg-light">
          <strong>Department:</strong> <%= tt.departmentName || 'Computer' %> &nbsp;|&nbsp;
          <strong>Academic Year:</strong> <%= tt.academicYearName || '2024-2025' %>

          <% if (tt.createdAt) { %>
            <span class="text-muted float-end">
              Generated on: <%= new Date(tt.createdAt).toLocaleString() %>
            </span>
          <% } %>
        </div>

        <div class="card-body">
          <!-- VIEW TIMETABLE -->
          <a href="/timetable/view?tid=<%= tt._id %>" class="btn btn-sm btn-info me-2">
            <i class="bi bi-eye"></i> View Timetable
          </a>

          <!-- DELETE BUTTON -->
          <button 
            class="btn btn-sm btn-danger" 
            onclick="if(confirm('Delete this entire timetable?')) deleteTimetable('<%= tt._id %>');"
          >
            <i class="bi bi-trash"></i> Delete Timetable
          </button>

          <!-- LIST OF CLASSES -->
          <% if (tt.classes && tt.classes.length > 0) { %>
            <hr>
            <strong>Classes in this timetable:</strong>
            <ul class="mt-2">
              <% tt.classes.forEach(cls => { %>
                <li>
                  <strong><%= cls.className || 'Unnamed Class' %></strong>
                  - <a href="/timetable/edit?tid=<%= tt._id %>&classId=<%= cls.classId %>" class="btn btn-sm btn-link">Edit</a>
                </li>
              <% }) %>
            </ul>
          <% } %>
        </div>
      </div>
    <% }); %>
  <% } else { %>
    <div class="alert alert-warning text-center">
      No timetables have been saved yet.
    </div>
  <% } %>
</div>

<%- include('../layout/footer') %>

<script>
  function deleteTimetable(tid) {
    fetch(`/timetable/delete?tid=${tid}`, { method: 'DELETE' })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          window.location.reload();
        } else {
          alert(data.error || 'Failed to delete timetable.');
        }
      })
      .catch(err => {
        console.error('Error deleting timetable:', err);
        alert('Server error while deleting timetable.');
      });
  }
</script>