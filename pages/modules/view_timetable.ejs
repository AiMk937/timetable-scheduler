<%- include('../layout/header') %>

<style>
  /* 1) Base table styling */
  .timetable-compact {
    font-size: 0.95rem;
    table-layout: fixed;
    width: 100%;
    border: 1px solid #dee2e6;
    border-radius: 0.25rem;
    overflow: hidden;
  }
  .timetable-compact th,
  .timetable-compact td {
    white-space: normal;
    word-wrap: break-word;
    overflow-wrap: break-word;
    padding: 0.75rem 0.5rem;
    vertical-align: middle;
  }
  .timetable-compact th {
    background-color: #343a40;
    color: #ffffff;
    border-bottom: 2px solid #495057;
  }
  .timetable-compact tr:nth-child(odd) td {
    background-color: #f8f9fa;
  }
  .timetable-compact tr:nth-child(even) td {
    background-color: #ffffff;
  }
  .timetable-compact tbody tr:hover td {
    background-color: #e9ecef;
  }

  /* 2) “Lab” vs “Theory” session blocks */
  .lab-session {
    background-color: #e3f2fd;       /* Light blue */
    border: 1px solid #90caf9;
    border-radius: 0.25rem;
    padding: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .lab-session .batch-badge {
    background-color: #1976d2;
    color: #ffffff;
    font-size: 0.85rem;
    margin-bottom: 0.25rem;
  }

  .theory-session {
    background-color: #f1f3f5;       /* Light gray */
    border: 1px solid #ced4da;
    border-radius: 0.25rem;
    padding: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .free-slot {
    color: #6c757d;
    font-style: italic;
  }

  /* 3) Card header styling */
  .tt-header-card {
    background-color: #007bff;
    color: #ffffff;
    border-bottom: none;
    font-weight: 500;
  }

  .tt-header-card h4,
  .tt-header-card h5 {
    color: #ffffff;
    margin-bottom: 0.25rem;
  }

  /* 4) Responsive tweaks */
  @media (max-width: 576px) {
    .timetable-compact th,
    .timetable-compact td {
      font-size: 0.8rem;
      padding: 0.5rem 0.25rem;
    }
    .lab-session, .theory-session {
      padding: 0.25rem;
      margin-bottom: 0.25rem;
    }
  }
</style>

<div class="container my-5">
  

  <!-- 1) Header Card: Department / Class / Academic Year -->
  <div class="card mb-4 shadow-sm">
    <div class="card-body tt-header-card text-center">
      <h4 class="mb-1">Department: <%= departmentName %></h4>
      <h5 class="mb-1">Class: <%= className %></h5>
      <h5 class="mb-2">Academic Year: <%= academicYearName %></h5>
      <% if (createdAt) { %>
        <small>Generated on: <%= new Date(createdAt).toLocaleString() %></small>
      <% } %>
    </div>
  </div>

  <!-- 2) Timetable Card -->
  <div class="card shadow-sm">
    <div class="card-header bg-secondary text-white text-center">
      <strong>Weekly Timetable</strong>
    </div>
    <div class="card-body">
      <% 
        const daysOrder = ["Monday","Tuesday","Wednesday","Thursday","Friday"];
        const numSlots = Array.isArray(timetable[daysOrder[0]]) 
                          ? timetable[daysOrder[0]].length 
                          : 0;
      %>

      <% if (numSlots === 0) { %>
        <div class="alert alert-warning text-center mb-0">
          This class has no timetable data for the selected week.
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table timetable-compact mb-0">
            <thead>
              <tr>
                <th style="width: 70px;">Slot</th>
                <% daysOrder.forEach(function(day) { %>
                  <th><%= day %></th>
                <% }); %>
              </tr>
            </thead>
            <tbody>
              <% for (let slotIndex = 0; slotIndex < numSlots; slotIndex++) { %>
                <tr>
                  <td class="text-center font-weight-bold">Slot <%= slotIndex+1 %></td>
                  <% daysOrder.forEach(function(day) { 
                       const cell = (timetable[day] || [])[slotIndex]; 
                  %>
                    <td>
                      <% if (Array.isArray(cell) && cell.length > 0) { %>
                        <!-- CASE A: Lab‐batch block -->
                        <% cell.forEach(function(entry, idx) { %>
                          <div class="lab-session">
                            <% if (entry.batch) { %>
                              <span class="batch-badge badge"><%= entry.batch %></span><br>
                            <% } %>
                            <span class="d-block font-weight-bold"><%= entry.subject %></span>
                            <small class="text-muted">
                              Teacher: <%= entry.teacher || 'TBA' %><br>
                              Room:    <%= entry.room %>
                            </small>
                          </div>
                          <% if (idx < cell.length - 1) { %>
                            <hr class="my-1">
                          <% } %>
                        <% }); %>

                      <% } else if (cell && cell.subject) { %>
                        <!-- CASE B: Single Lecture -->
                        <div class="theory-session">
                          <span class="d-block font-weight-bold"><%= cell.subject %></span>
                          <small class="text-muted">
                            Teacher: <%= cell.teacher || 'TBA' %><br>
                            Room:    <%= cell.room %>
                          </small>
                        </div>

                      <% } else { %>
                        <!-- CASE C: Free -->
                        <div class="free-slot">FREE</div>
                      <% } %>
                    </td>
                  <% }); %>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

</div>

<%- include('../layout/footer') %>