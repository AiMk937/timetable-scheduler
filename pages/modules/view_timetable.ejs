<!-- views/modules/view_timetable.ejs -->

<%- include('../layout/header') %>

<style>
  /* === Base table styling === */
  .timetable-compact {
    font-size: 0.95rem;
    table-layout: fixed;
    width: 100%;
    border: 1px solid #dee2e6;
    border-radius: 0.25rem;
    overflow: hidden;
  }
  .timetable-compact th,
  .timetable-compact td {
    white-space: normal;
    word-wrap: break-word;
    overflow-wrap: break-word;
    padding: 0.75rem 0.5rem;
    vertical-align: middle;
  }
  .timetable-compact th {
    background-color: #343a40;
    color: #ffffff;
    border-bottom: 2px solid #495057;
    text-transform: uppercase;
    font-size: 0.9rem;
  }
  .timetable-compact tr:nth-child(odd) td {
    background-color: #f8f9fa;
  }
  .timetable-compact tr:nth-child(even) td {
    background-color: #ffffff;
  }
  .timetable-compact tbody tr:hover td {
    background-color: #e9ecef;
  }

  /* === “Lab” vs “Theory” styling === */
  .lab-session {
    background-color: #e3f2fd;       /* Light blue */
    border: 1px solid #90caf9;
    border-radius: 0.25rem;
    padding: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .lab-session .batch-badge {
    background-color: #1976d2;
    color: #ffffff;
    font-size: 0.85rem;
    margin-bottom: 0.25rem;
    display: inline-block;
    padding: 0.2rem 0.5rem;
    border-radius: 0.2rem;
  }

  .theory-session {
    background-color: #f1f3f5;       /* Light gray */
    border: 1px solid #ced4da;
    border-radius: 0.25rem;
    padding: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .free-slot {
    color: #6c757d;
    font-style: italic;
  }

  /* === Header card styling === */
  .tt-header-card {
    background-color: #007bff;
    color: #ffffff;
    text-align: center;
    padding: 1rem;
    border-radius: 0.25rem;
    margin-bottom: 0.5rem; /* Small gap under header */
  }
  .tt-header-card h4,
  .tt-header-card h5 {
    color: #ffffff;
    margin-bottom: 0.25rem;
    font-weight: 500;
  }
  .tt-header-card small {
    color: rgba(255, 255, 255, 0.85);
  }

  /* === “Edit” button styling (below header) === */
  .edit-button-container {
    text-align: right;
    margin-bottom: 1rem;
  }
  .edit-button-container .btn {
    background-color: #28a745;  /* Green */
    color: #ffffff;
    border: none;
    font-size: 0.9rem;
    padding: 0.4rem 0.8rem;
  }
  .edit-button-container .btn:hover {
    background-color: #218838;
  }

  /* === “Weekly Timetable” card header === */
  .tt-card-header {
    background-color: #6c757d;
    color: #ffffff;
    padding: 0.75rem 1rem;
    font-weight: 500;
    font-size: 1rem;
    text-align: center;
    border-bottom: 1px solid #5a6268;
    border-top-left-radius: 0.25rem;
    border-top-right-radius: 0.25rem;
  }

  /* === Responsive tweaks === */
  @media (max-width: 576px) {
    .timetable-compact th,
    .timetable-compact td {
      font-size: 0.8rem;
      padding: 0.5rem 0.25rem;
    }
    .lab-session, .theory-session {
      padding: 0.3rem;
      margin-bottom: 0.3rem;
    }
    .edit-button-container .btn {
      font-size: 0.8rem;
      padding: 0.3rem 0.6rem;
    }
  }
</style>

<div class="container my-5">

  <!-- === Header Card: Department / Class / Academic Year === -->
  <div class="tt-header-card">
    <h4 class="mb-1">Department: <%= departmentName %></h4>
    <h5 class="mb-1">Class:      <%= className %></h5>
    <h5 class="mb-2">Academic Year: <%= academicYearName %></h5>
    <% if (createdAt) { %>
      <small>Generated on: <%= new Date(createdAt).toLocaleString() %></small>
    <% } %>
  </div>

  <% /* === Place “Edit Timetable” right below the header card, only if tid/classId exist === */ %>
  <% if (typeof tid !== 'undefined' && typeof classId !== 'undefined') { %>
    <div class="edit-button-container">
      <a 
        href="/timetable/edit?tid=<%= tid %>&classId=<%= classId %>"
        class="btn btn-sm"
      >
        <i class="bi bi-pencil-square me-1"></i> Edit Timetable
      </a>
    </div>
  <% } %>


  <!-- === Timetable Card === -->
  <div class="card shadow-sm">
    <div class="tt-card-header">Weekly Timetable</div>
    <div class="card-body p-0">
      <% 
        const daysOrder = ["Monday","Tuesday","Wednesday","Thursday","Friday"];
        const numSlots   = Array.isArray(timetable[daysOrder[0]]) 
                           ? timetable[daysOrder[0]].length 
                           : 0;
      %>

      <% if (numSlots === 0) { %>
        <div class="alert alert-warning m-3 text-center">
          This class has no timetable data for the selected week.
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table timetable-compact mb-0">
            <thead>
              <tr>
                <th style="width: 70px;">Slot</th>
                <% daysOrder.forEach(function(day) { %>
                  <th><%= day %></th>
                <% }); %>
              </tr>
            </thead>
            <tbody>
              <% for (let slotIndex = 0; slotIndex < numSlots; slotIndex++) { %>
                <tr>
                  <td class="text-center fw-bold">Slot <%= slotIndex + 1 %></td>
                  <% daysOrder.forEach(function(day) { 
                       const cell = (timetable[day] || [])[slotIndex]; 
                  %>
                    <td>
                      <% if (Array.isArray(cell) && cell.length > 0) { %>
                        <!-- === Lab‐batch block === -->
                        <% cell.forEach(function(entry, idx) { %>
                          <div class="lab-session">
                            <% if (entry.batch) { %>
                              <span class="batch-badge"><%= entry.batch %></span><br>
                            <% } %>
                            <span class="d-block fw-bold"><%= entry.subject %></span>
                            <small class="text-muted">
                              Teacher: <%= entry.teacher || 'TBA' %><br>
                              Room:    <%= entry.room %>
                            </small>
                          </div>
                          <% if (idx < cell.length - 1) { %>
                            <hr class="my-1">
                          <% } %>
                        <% }); %>

                      <% } else if (cell && cell.subject) { %>
                        <!-- === Single Lecture === -->
                        <div class="theory-session">
                          <span class="d-block fw-bold"><%= cell.subject %></span>
                          <small class="text-muted">
                            Teacher: <%= cell.teacher || 'TBA' %><br>
                            Room:    <%= cell.room %>
                          </small>
                        </div>

                      <% } else { %>
                        <!-- === Free Slot === -->
                        <div class="free-slot">FREE</div>
                      <% } %>
                    </td>
                  <% }); %>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../layout/footer') %>