<!-- views/modules/edit_timetable.ejs -->
<%- include('../layout/header') %>

<style>
  .timetable-compact {
    font-size: 0.95rem;
    table-layout: fixed;
    width: 100%;
    border: 1px solid #dee2e6;
    border-radius: 0.25rem;
    overflow: hidden;
  }
  .timetable-compact th,
  .timetable-compact td {
    white-space: normal;
    word-wrap: break-word;
    overflow-wrap: break-word;
    padding: 0.6rem;
    vertical-align: middle;
  }
  .timetable-compact th {
    background-color: #343a40;
    color: #ffffff;
  }
  .timetable-compact tr:nth-child(odd) td {
    background-color: #f8f9fa;
  }
  .timetable-compact tr:nth-child(even) td {
    background-color: #ffffff;
  }
  .timetable-compact tbody tr:hover td {
    background-color: #e9ecef;
  }
  .lab-session {
    background-color: #e3f2fd;
    border: 1px solid #90caf9;
    border-radius: 0.25rem;
    padding: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .lab-session .batch-badge {
    background-color: #1976d2;
    color: #ffffff;
    font-size: 0.85rem;
    margin-bottom: 0.25rem;
    display: inline-block;
    padding: 0.15rem 0.4rem;
    border-radius: 0.2rem;
  }
  .theory-session {
    background-color: #f1f3f5;
    border: 1px solid #ced4da;
    border-radius: 0.25rem;
    padding: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .free-slot {
    color: #6c757d;
    font-style: italic;
  }
  .highlight-changed {
    background-color: #ccffcc !important; /* light green */
    transition: background-color 1s ease;
  }
  .chat-container {
    margin-top: 2rem;
    border: 1px solid #ccc;
    padding: 1rem;
    border-radius: 6px;
  }
  #chat-window {
    height: 300px;
    overflow-y: auto;
    border: 1px solid #eee;
    padding: 0.75rem;
    background-color: #fafafa;
    margin-bottom: 1rem;
    border-radius: 4px;
  }
  .chat-message {
    margin-bottom: 0.5rem;
  }
  .chat-message.user {
    text-align: right;
    color: #0d47a1;
  }
  .chat-message.system {
    text-align: left;
    color: #1b5e20;
  }
</style>

<div class="container mt-5">
  <% if (!timetable) { %>
    <p class="text-center text-muted">No timetable data available for editing.</p>
  <% } else { %>
    <h2 class="text-center mb-2">Edit Timetable</h2>
    <div class="text-center mb-3">
      <% if (className) { %>
        <h4>Class: <%= className %></h4>
      <% } %>
      <% if (academicYearName) { %>
        <h5>Academic Year: <%= academicYearName %></h5>
      <% } %>
      <% if (createdAt) { %>
        <p class="text-muted">Generated on: <%= new Date(createdAt).toLocaleString() %></p>
      <% } %>
    </div>

    <!-- ============================
         1) Render the editable timetable
         ============================ -->
    <div class="table-responsive mb-4">
      <table class="table table-sm table-bordered table-hover timetable-compact">
        <thead class="thead-dark">
          <tr>
            <th style="width: 60px;">Slot</th>
            <% const daysOrder = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"]; %>
            <% daysOrder.forEach(day => { %>
              <th><%= day %></th>
            <% }); %>
          </tr>
        </thead>
        <tbody>
          <% 
            // Compute how many slots each day has (assume uniform length across days)
            const numSlots = Array.isArray(timetable[daysOrder[0]]) 
                              ? timetable[daysOrder[0]].length 
                              : 0;
            for (let slotIndex = 0; slotIndex < numSlots; slotIndex++) { 
          %>
            <tr>
              <td class="text-center align-middle"><strong>Slot <%= slotIndex + 1 %></strong></td>
              <% daysOrder.forEach(day => { 
                   // This “slotCell” can be:
                   //   • null (free)
                   //   • { subject, teacher, room } 
                   //   • an array of { batch, subject, teacher, room } (lab‐batch block)
                   const slotCell = (timetable[day] || [])[slotIndex];
              %>
                <td class="align-top" id="cell-<%= day %>-<%= slotIndex %>">
                  <% if (!slotCell) { %>
                    <span class="text-muted">-</span>
                  <% } else if (typeof slotCell === 'object' && slotCell.subject) { %>
                    <!-- Single-theory session -->
                    <div class="theory-session">
                      <strong><%= slotCell.subject %></strong><br>
                      <% if (slotCell.teacher) { %>Teacher: <%= slotCell.teacher %><br><% } %>
                      <% if (slotCell.room)    { %>Room: <%= slotCell.room %><% } %>
                    </div>
                  <% } else if (Array.isArray(slotCell) && slotCell.length > 0) { %>
                    <!-- Lab-batch block -->
                    <% slotCell.forEach((item, idx) => { %>
                      <div class="lab-session">
                        <% if (item.batch) { %>
                          <span class="batch-badge"><%= item.batch %></span><br>
                        <% } %>
                        <%= item.subject %><br>
                        Teacher: <%= item.teacher %><br>
                        Room: <%= item.room %>
                      </div>
                      <% if (idx < slotCell.length - 1) { %><hr class="my-1"><% } %>
                    <% }); %>
                  <% } else { %>
                    <span class="free-slot"><%= (typeof slotCell === 'string' ? slotCell : 'FREE') %></span>
                  <% } %>
                </td>
              <% }); %>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>


    <!-- ============================
         2) Chat interface & Save button
         ============================ -->
    <div class="chat-container">
      <h4>Conversation</h4>
      <div id="chat-window"></div>

      <form id="chat-form" autocomplete="off">
        <div class="form-group">
          <label for="chatInput">Your Message:</label>
          <input 
            type="text"
            id="chatInput"
            name="message"
            class="form-control"
            placeholder="e.g., 'Switch Physics slot 2 with Chemistry slot 4 on Tuesday'"
            required
          />
        </div>
        <input type="hidden" id="timetableId" value="<%= timetableId %>">
        <div class="d-flex">
          <button type="submit" class="btn btn-success mr-2">Send</button>
          <button 
            type="button" 
            id="save-button" 
            class="btn btn-primary ml-2"
            <% if (!timetableId) { %> disabled <% } %>
          >Save Timetable</button>
        </div>
      </form>
    </div>
  <% } %>
</div>

<script>
  // —————————————————————————————————————————————————————
  //  Utility to append chat messages:
  // —————————————————————————————————————————————————————
  function appendMessage(text, sender) {
    const chatWindow = document.getElementById('chat-window');
    const msgDiv = document.createElement('div');
    msgDiv.classList.add('chat-message', sender);
    msgDiv.textContent = text;
    chatWindow.appendChild(msgDiv);
    chatWindow.scrollTop = chatWindow.scrollHeight;
  }

  // —————————————————————————————————————————————————————
  // Build inner HTML for a single cell (day + slotIndex):
  // —————————————————————————————————————————————————————
  function buildSlotHTML(slotVal) {
    if (!slotVal) {
      return '<span class="text-muted">-</span>';
    }
    if (typeof slotVal === 'string') {
      return `<span class="free-slot">${slotVal === 'Free slot' ? 'Free slot' : slotVal}</span>`;
    }
    if (slotVal.subject) {
      // Single theory session
      let html = '<div class="theory-session">';
      html += `<strong>${slotVal.subject}</strong><br>`;
      if (slotVal.teacher) html += `Teacher: ${slotVal.teacher}<br>`;
      if (slotVal.room)    html += `Room: ${slotVal.room}`;
      html += '</div>';
      return html;
    }
    // Lab block (array of objects)
    let labHTML = '';
    for (const item of slotVal) {
      labHTML += '<div class="lab-session">';
      if (item.batch) labHTML += `<span class="batch-badge">${item.batch}</span><br>`;
      labHTML += `${item.subject}<br>`;
      labHTML += `Teacher: ${item.teacher}<br>`;
      labHTML += `Room: ${item.room}`;
      labHTML += '</div>';
    }
    return labHTML;
  }

  // —————————————————————————————————————————————————————
  // Update a single cell in the table and highlight it:
  // —————————————————————————————————————————————————————
  function updateSlotCell(day, slotIndex, newVal, highlight = false) {
    const cellId = `cell-${day}-${slotIndex}`;
    const cell = document.getElementById(cellId);
    if (!cell) return;
    cell.innerHTML = buildSlotHTML(newVal);
    if (highlight) {
      cell.classList.add('highlight-changed');
      setTimeout(() => cell.classList.remove('highlight-changed'), 3000);
    }
  }

  // —————————————————————————————————————————————————————
  // Called whenever the backend returns an updated timetable + changedSlots:
  // —————————————————————————————————————————————————————
  function updateTimetable(updatedTimetable, changedSlots) {
    window.draftTimetable = updatedTimetable;
    changedSlots.forEach(cs => {
      const { day, slot } = cs;
      const slotIndex = slot - 1;
      if (updatedTimetable[day] && updatedTimetable[day][slotIndex] !== undefined) {
        updateSlotCell(day, slotIndex, updatedTimetable[day][slotIndex], true);
      }
    });
  }

  // —————————————————————————————————————————————————————
  // Handle “Send” in the chat form:
  // —————————————————————————————————————————————————————
  document.getElementById('chat-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const chatInput = document.getElementById('chatInput');
    const message = chatInput.value.trim();
    if (!message) return;
    appendMessage(message, 'user');
    chatInput.value = '';

    const timetableId = document.getElementById('timetableId').value;
    try {
      const res = await fetch('/chatbot/converse', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ message, timetableId })
      });
      const data = await res.json();
      if (data.error) {
        appendMessage("Error: " + data.error, 'system');
      } else {
        if (data.reply) appendMessage(data.reply, 'system');
        if (data.updatedTimetable && data.changedSlots) {
          appendMessage("Timetable updated!", 'system');
          updateTimetable(data.updatedTimetable, data.changedSlots);
        }
      }
    } catch (err) {
      appendMessage("Failed to send message: " + err.toString(), 'system');
    }
  });

  // —————————————————————————————————————————————————————
  // Handle “Save Timetable” button click:
  // —————————————————————————————————————————————————————
  document.getElementById('save-button').addEventListener('click', async () => {
    if (!window.draftTimetable) {
      appendMessage("No changes to save.", 'system');
      return;
    }
    const timetableId = document.getElementById('timetableId').value;
    try {
      const res = await fetch('/timetable/save-draft', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({
          timetableId,
          updatedTimetable: window.draftTimetable
        })
      });
      const result = await res.json();
      if (result.error) {
        appendMessage("Error saving timetable: " + result.error, 'system');
      } else {
        appendMessage("Timetable saved successfully!", 'system');
      }
    } catch (err) {
      appendMessage("Failed to save timetable: " + err.toString(), 'system');
    }
  });
</script>

<%- include('../layout/footer') %>