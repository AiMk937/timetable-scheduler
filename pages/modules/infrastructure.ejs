<%- include('../layout/header') %>

<!-- Use a nicer system font and bump text sizes -->
<style>
  body {
    font-family: 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  }
  .list-group-item {
    font-size: 1rem;
    line-height: 1.4;
  }
  .form-check-label {
    font-weight: 500;
  }
  .form-check-input {
    margin-top: 0.3rem;
  }
  .btn-toggle {
    min-width: 120px;
  }
</style>

<div class="container my-4">
  <h1 class="mb-4">Infrastructure</h1>

  <!-- Add Room Button -->
  <button id="toggleAddBtn" class="btn btn-primary btn-toggle mb-3">
    Add Room
  </button>

  <!-- Add Room Form -->
  <div id="addForm" class="card mb-5" style="display: none;">
    <div class="card-body">
      <h5 class="card-title">New Room</h5>
      <form action="/infrastructure" method="POST">
        <div class="form-row">
          <div class="form-group col-md-5">
            <label for="roomNo">Room No</label>
            <input type="text" id="roomNo" name="roomNo" class="form-control" required>
          </div>
          <div class="form-group col-md-5">
            <label for="addType">Type</label>
            <select id="addType" name="type" class="form-control" required onchange="toggleAddLabSubjects()">
              <option value="classroom">Classroom</option>
              <option value="lab">Lab</option>
            </select>
          </div>
        </div>

        <!-- Departments as checkboxes -->
        <div class="form-group">
          <label class="font-weight-bold">Departments</label>
          <div class="row">
            <% departments.forEach(dept => { %>
              <div class="col-sm-6 col-md-4">
                <div class="form-check">
                  <input
                    class="form-check-input"
                    type="checkbox"
                    name="departmentIds[]"
                    id="dept-<%= dept._id %>"
                    value="<%= dept._id %>"
                  >
                  <label class="form-check-label" for="dept-<%= dept._id %>">
                    <%= dept.departmentName %>
                  </label>
                </div>
              </div>
            <% }) %>
          </div>
        </div>

        <!-- Classes as checkboxes -->
        <div class="form-group">
          <label class="font-weight-bold">Classes</label>
          <div class="row">
            <% classes.forEach(cls => { %>
              <div class="col-sm-6 col-md-4">
                <div class="form-check">
                  <input
                    class="form-check-input"
                    type="checkbox"
                    name="classIds[]"
                    id="cls-<%= cls._id %>"
                    value="<%= cls._id %>"
                  >
                  <label class="form-check-label" for="cls-<%= cls._id %>">
                    <%= cls.className %>
                  </label>
                </div>
              </div>
            <% }) %>
          </div>
        </div>

        <!-- Lab Subjects (only if Lab) -->
        <div id="addLabSubjectsDiv" class="form-group" style="display: none;">
          <label class="font-weight-bold">Lab Subjects</label>
          <div class="row">
            <% subjects.filter(s => s.subjectType === 'Lab').forEach(subject => { %>
              <div class="col-sm-6 col-md-4">
                <div class="form-check">
                  <input
                    class="form-check-input"
                    type="checkbox"
                    name="labSubjectId[]"
                    id="labSub-<%= subject._id %>"
                    value="<%= subject._id %>"
                  >
                  <label class="form-check-label" for="labSub-<%= subject._id %>">
                    <%= subject.subjectName %>
                  </label>
                </div>
              </div>
            <% }) %>
          </div>
        </div>

        <button type="submit" class="btn btn-success">Save Room</button>
      </form>
    </div>
  </div>

  <!-- Existing Rooms as a list-group -->
  <ul class="list-group">
    <% infrastructures.forEach(inf => {
         const selDepts = Array.isArray(inf.departmentIds)
           ? inf.departmentIds.map(d => d._id.toString())
           : [];
         const selClasses = Array.isArray(inf.classIds)
           ? inf.classIds.map(c => c._id.toString())
           : [];
    %>
      <li class="list-group-item">
        <h5 class="mb-2">
          <strong>Room No:</strong> <%= inf.roomNo %>
          <small class="text-muted">(<%= inf.type %>)</small>
        </h5>
        <p class="mb-1"><strong>Departments:</strong>
          <% if (selDepts.length) { %>
            <%= departments
                  .filter(d => selDepts.includes(d._id.toString()))
                  .map(d => d.departmentName)
                  .join(', ')
            %>
          <% } else { %>NULL<% } %>
        </p>
        <p class="mb-1"><strong>Classes:</strong>
          <% if (selClasses.length) { %>
            <%= classes
                  .filter(c => selClasses.includes(c._id.toString()))
                  .map(c => c.className)
                  .join(', ')
            %>
          <% } else { %>NULL<% } %>
        </p>

        <% if (inf.type === 'lab') {
             const labSubs = Array.isArray(inf.labSubjectId) ? inf.labSubjectId : [];
        %>
          <p class="mb-1"><strong>Lab Subjects:</strong>
            <% if (labSubs.length) { %>
              <%= labSubs.map(s => s ? s.subjectName : 'NULL').join(', ') %>
            <% } else { %> NULL <% } %>
          </p>
        <% } %>

        <div class="mt-3">
          <button
            class="btn btn-sm btn-warning btn-toggle"
            onclick="toggleEditForm('<%= inf._id %>')"
          >Edit</button>
          <form
            action="/infrastructure/delete/<%= inf._id %>?_method=DELETE"
            method="POST"
            class="d-inline"
          >
            <button class="btn btn-sm btn-danger">Delete</button>
          </form>
        </div>

        <!-- Edit Form -->
        <div
          id="editForm-<%= inf._id %>"
          class="mt-3"
          style="display: none;"
        >
          <form action="/infrastructure/<%= inf._id %>?_method=PUT" method="POST">
            <div class="form-row">
              <div class="form-group col-md-5">
                <label>Room No</label>
                <input
                  type="text"
                  name="roomNo"
                  class="form-control"
                  value="<%= inf.roomNo %>"
                  required
                >
              </div>
              <div class="form-group col-md-5">
                <label>Type</label>
                <select
                  id="editType-<%= inf._id %>"
                  name="type"
                  class="form-control"
                  required
                  onchange="toggleEditLabSubjects('<%= inf._id %>')"
                >
                  <option value="classroom" <%= inf.type==='classroom'?'selected':'' %>>
                    Classroom
                  </option>
                  <option value="lab" <%= inf.type==='lab'?'selected':'' %>>
                    Lab
                  </option>
                </select>
              </div>
            </div>

            <!-- Departments checkboxes -->
            <div class="form-group">
              <label class="font-weight-bold">Departments</label>
              <div class="row">
                <% departments.forEach(dept => { %>
                  <div class="col-sm-6 col-md-4">
                    <div class="form-check">
                      <input
                        class="form-check-input"
                        type="checkbox"
                        name="departmentIds[]"
                        id="editDept-<%= inf._id %>-<%= dept._id %>"
                        value="<%= dept._id %>"
                        <%= selDepts.includes(dept._id.toString()) ? 'checked' : '' %>
                      >
                      <label class="form-check-label" for="editDept-<%= inf._id %>-<%= dept._id %>">
                        <%= dept.departmentName %>
                      </label>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>

            <!-- Classes checkboxes -->
            <div class="form-group">
              <label class="font-weight-bold">Classes</label>
              <div class="row">
                <% classes.forEach(cls => { %>
                  <div class="col-sm-6 col-md-4">
                    <div class="form-check">
                      <input
                        class="form-check-input"
                        type="checkbox"
                        name="classIds[]"
                        id="editCls-<%= inf._id %>-<%= cls._id %>"
                        value="<%= cls._id %>"
                        <%= selClasses.includes(cls._id.toString()) ? 'checked' : '' %>
                      >
                      <label class="form-check-label" for="editCls-<%= inf._id %>-<%= cls._id %>">
                        <%= cls.className %>
                      </label>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>

            <!-- Lab Subjects checkboxes -->
            <div
              id="editLabSubjectsDiv-<%= inf._id %>"
              class="form-group"
              style="<%= inf.type==='lab' ? 'display:block;' : 'display:none;' %>"
            >
              <label class="font-weight-bold">Lab Subjects</label>
              <div class="row">
                <% subjects.filter(s=>s.subjectType==='Lab').forEach(subject => { %>
                  <div class="col-sm-6 col-md-4">
                    <div class="form-check">
                      <input
                        class="form-check-input"
                        type="checkbox"
                        name="labSubjectId[]"
                        id="editLabSub-<%= inf._id %>-<%= subject._id %>"
                        value="<%= subject._id %>"
                        <%= Array.isArray(inf.labSubjectId) &&
                            inf.labSubjectId.some(s=>s._id.toString()===subject._id.toString())
                              ? 'checked' : '' %>
                      >
                      <label class="form-check-label" for="editLabSub-<%= inf._id %>-<%= subject._id %>">
                        <%= subject.subjectName %>
                      </label>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>

            <button type="submit" class="btn btn-success">Save Changes</button>
          </form>
        </div>
      </li>
    <% }) %>
  </ul>
</div>

<script>
  // Toggle Add form
  document.getElementById('toggleAddBtn').addEventListener('click', () => {
    const f = document.getElementById('addForm');
    f.style.display = f.style.display==='none' ? 'block' : 'none';
  });

  function toggleAddLabSubjects() {
    const div = document.getElementById('addLabSubjectsDiv');
    div.style.display = document.getElementById('addType').value==='lab' ? 'block' : 'none';
  }

  function toggleEditForm(id) {
    const f = document.getElementById(`editForm-${id}`);
    f.style.display = f.style.display==='none' ? 'block' : 'none';
  }

  function toggleEditLabSubjects(id) {
    const div = document.getElementById(`editLabSubjectsDiv-${id}`);
    div.style.display = document.getElementById(`editType-${id}`).value==='lab' ? 'block' : 'none';
  }
</script>

<%- include('../layout/footer') %>