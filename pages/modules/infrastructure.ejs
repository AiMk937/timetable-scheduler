<%- include('../layout/header') %>

<div class="container mt-4">
  <h1 class="mb-4">Infrastructure:</h1>

  <!-- Button to toggle the add form -->
  <button id="toggleFormBtn" class="btn btn-primary mb-3" onclick="toggleAddForm()">Add Room</button>

  <!-- Form to add a new room (hidden by default) -->
  <form id="addForm" action="/infrastructure" method="POST" class="mb-5" style="display:none;">
    <!-- Room No -->
    <div class="form-group">
      <label for="roomNo">Room No:</label>
      <input
        type="text"
        id="roomNo"
        name="roomNo"
        class="form-control"
        placeholder="Enter room number"
        required
      >
    </div>

    <!-- Room Type -->
    <div class="form-group">
      <label for="type">Type:</label>
      <select
        id="type"
        name="type"
        class="form-control"
        required
        onchange="toggleLabSubjects()"
      >
        <option value="classroom">Classroom</option>
        <option value="lab">Lab</option>
      </select>
    </div>

    <!-- Department -->
    <div class="form-group">
      <label for="departmentId">Department:</label>
      <select
        id="departmentId"
        name="departmentId"
        class="form-control"
        required
      >
        <% departments.forEach((department) => { %>
          <option value="<%= department._id %>">
            <%= department.departmentName %>
          </option>
        <% }); %>
      </select>
    </div>

    <!-- Class -->
    <div class="form-group">
      <label for="classId">Class:</label>
      <select
        id="classId"
        name="classId"
        class="form-control"
        required
      >
        <% classes.forEach((classItem) => { %>
          <option value="<%= classItem._id %>">
            <%= classItem.className %>
          </option>
        <% }); %>
      </select>
    </div>

    <!-- Lab Subjects Checkboxes (hidden by default) -->
    <div
      id="labSubjectsDiv"
      class="form-group"
      style="display:none;"
    >
      <label>Lab Subjects:</label>
      <% subjects.forEach((subject) => { %>
        <% if (subject.subjectType === 'Lab') { %>
          <div class="form-check">
            <input
              type="checkbox"
              class="form-check-input"
              name="labSubjectId"
              value="<%= subject._id %>"
              id="labSub-<%= subject._id %>"
            >
            <label
              class="form-check-label"
              for="labSub-<%= subject._id %>"
            >
              <%= subject.subjectName %>
            </label>
          </div>
        <% } %>
      <% }); %>
    </div>

    <button type="submit" class="btn btn-success">Add Room</button>
  </form>

  <!-- Display existing rooms -->
  <ul class="list-group">
    <% infrastructures.forEach((infrastructure) => { %>
      <li class="list-group-item">
        <!-- Basic info -->
        <strong>Room No:</strong> <%= infrastructure.roomNo %>
        <strong>(<%= infrastructure.type %>)</strong>
        <br>
        <strong>Department:</strong>
        <%= infrastructure.departmentId.departmentName %>
        <br>
        <strong>Class:</strong>
        <%= infrastructure.classId.className %>
        
        <!-- Lab Subjects (if any) -->
        <% if (infrastructure.type === 'lab' && infrastructure.labSubjectId && infrastructure.labSubjectId.length > 0) { %>
          <br>
          <strong>Lab Subjects:</strong>
          <ul class="mb-2 pl-4">
            <% infrastructure.labSubjectId.forEach(function(subject) { %>
              <li class="mb-1">
                <%= subject.subjectName %>
              </li>
            <% }); %>
          </ul>
        <% } %>

        <div class="mt-2">
          <!-- Delete button -->
          <form
            action="/infrastructure/delete/<%= infrastructure._id %>?_method=DELETE"
            method="POST"
            class="d-inline"
          >
            <button type="submit" class="btn btn-sm btn-danger">
              Delete
            </button>
          </form>

          <!-- Edit button -->
          <button
            class="btn btn-sm btn-warning"
            onclick="toggleEditForm('<%= infrastructure._id %>')"
          >
            Edit
          </button>
        </div>

        <!-- Edit form (hidden initially) -->
        <div
          id="editForm-<%= infrastructure._id %>"
          style="display: none;"
          class="mt-3"
        >
          <form
            action="/infrastructure/<%= infrastructure._id %>?_method=PUT"
            method="POST"
          >
            <!-- Room No -->
            <div class="form-group">
              <label for="roomNo">Room No:</label>
              <input
                type="text"
                name="roomNo"
                class="form-control"
                value="<%= infrastructure.roomNo %>"
                required
              >
            </div>

            <!-- Room Type -->
            <div class="form-group">
              <label for="type">Type:</label>
              <select
                name="type"
                class="form-control"
                required
                onchange="toggleEditLabSubjects('<%= infrastructure._id %>')"
              >
                <option
                  value="classroom"
                  <%= infrastructure.type === 'classroom' ? 'selected' : '' %>
                >
                  Classroom
                </option>
                <option
                  value="lab"
                  <%= infrastructure.type === 'lab' ? 'selected' : '' %>
                >
                  Lab
                </option>
              </select>
            </div>

            <!-- Department -->
            <div class="form-group">
              <label for="departmentId">Department:</label>
              <select
                name="departmentId"
                class="form-control"
                required
              >
                <% departments.forEach((department) => { %>
                  <option
                    value="<%= department._id %>"
                    <%= department._id.equals(infrastructure.departmentId._id) ? 'selected' : '' %>
                  >
                    <%= department.departmentName %>
                  </option>
                <% }); %>
              </select>
            </div>

            <!-- Class -->
            <div class="form-group">
              <label for="classId">Class:</label>
              <select
                name="classId"
                class="form-control"
                required
              >
                <% classes.forEach((classItem) => { %>
                  <option
                    value="<%= classItem._id %>"
                    <%= classItem._id.equals(infrastructure.classId._id) ? 'selected' : '' %>
                  >
                    <%= classItem.className %>
                  </option>
                <% }); %>
              </select>
            </div>

            <!-- Lab Subjects (checkboxes) -->
            <div
              id="editLabSubjectsDiv-<%= infrastructure._id %>"
              class="form-group"
              style="<%= infrastructure.type === 'lab' ? '' : 'display:none;' %>"
            >
              <label>Lab Subjects:</label>
              <% subjects.forEach((subject) => { %>
                <% if (subject.subjectType === 'Lab') { %>
                  <div class="form-check">
                    <input
                      type="checkbox"
                      class="form-check-input"
                      name="labSubjectId"
                      value="<%= subject._id %>"
                      id="editLabSub-<%= infrastructure._id %>-<%= subject._id %>"
                      <%= infrastructure.labSubjectId &&
                          infrastructure.labSubjectId.some(
                            s => s._id.toString() === subject._id.toString()
                          )
                          ? 'checked'
                          : ''
                      %>
                    >
                    <label
                      class="form-check-label"
                      for="editLabSub-<%= infrastructure._id %>-<%= subject._id %>"
                    >
                      <%= subject.subjectName %>
                    </label>
                  </div>
                <% } %>
              <% }); %>
            </div>

            <button type="submit" class="btn btn-primary">Save Changes</button>
          </form>
        </div>
      </li>
    <% }); %>
  </ul>
</div>

<script>
  // Toggle the "Add Room" form
  function toggleAddForm() {
    const form = document.getElementById('addForm');
    form.style.display = (form.style.display === 'none' || form.style.display === '') ? 'block' : 'none';
  }

  // Show/hide lab subjects in the Add form
  function toggleLabSubjects() {
    const typeSelect = document.getElementById('type');
    const labDiv = document.getElementById('labSubjectsDiv');
    labDiv.style.display = (typeSelect.value === 'lab') ? 'block' : 'none';
  }

  // Show/hide the Edit form for a specific infrastructure item
  function toggleEditForm(id) {
    const form = document.getElementById('editForm-' + id);
    form.style.display = (form.style.display === 'none' || form.style.display === '') ? 'block' : 'none';
  }

  // Show/hide lab subjects in the Edit form
  function toggleEditLabSubjects(id) {
    const editLabDiv = document.getElementById('editLabSubjectsDiv-' + id);
    // Find the type select within the parent form
    const parentForm = editLabDiv.closest('form');
    const typeSelect = parentForm.querySelector('select[name="type"]');
    editLabDiv.style.display = (typeSelect.value === 'lab') ? 'block' : 'none';
  }
</script>

<%- include('../layout/footer') %>
