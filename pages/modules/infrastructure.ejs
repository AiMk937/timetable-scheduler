<%- include('../layout/header') %>

<style>
  /* keep badges readable */
  .badge { color: #000 !important; }
  .form-check-input { margin-top: .3rem; }
  .form-check-label { font-weight: 500; }
</style>

<div class="container mt-4">
  <h1 class="mb-4">Infrastructure</h1>

  <!-- Add Room Button -->
  <button class="btn btn-primary mb-3" data-toggle="collapse" data-target="#addForm">
    <i class="bi bi-plus-lg"></i> Add Room
  </button>

  <!-- Add Room Form -->
  <div id="addForm" class="collapse mb-4">
    <div class="card shadow-sm">
      <div class="card-body">
        <h5 class="card-title">New Room</h5>
        <form action="/infrastructure" method="POST">
          <div class="form-row">
            <div class="form-group col-md-6">
              <label for="roomNo">Room No</label>
              <input type="text" id="roomNo" name="roomNo" class="form-control" required>
            </div>
            <div class="form-group col-md-6">
              <label for="addType">Type</label>
              <select id="addType" name="type" class="form-control" required onchange="toggleAddLabSubjects()">
                <option value="classroom">Classroom</option>
                <option value="lab">Lab</option>
              </select>
            </div>
          </div>

          <!-- Departments -->
          <div class="form-group">
            <label class="font-weight-bold">Departments</label>
            <div class="row">
              <% departments.forEach(dept => { %>
                <div class="col-sm-6 col-md-4">
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="departmentIds[]" value="<%=dept._id%>">
                    <label class="form-check-label"><%=dept.departmentName%></label>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>

          <!-- Classes -->
          <div class="form-group">
            <label class="font-weight-bold">Classes</label>
            <div class="row">
              <% classes.forEach(cls => { %>
                <div class="col-sm-6 col-md-4">
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="classIds[]" value="<%=cls._id%>">
                    <label class="form-check-label"><%=cls.className%></label>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>

          <!-- Lab Subjects (shown whenever Type=Lab) -->
          <div id="addLabSubjectsDiv" class="form-group" style="display:none;">
            <label class="font-weight-bold">Lab Subjects</label>
            <div class="row">
              <% subjects
                  .filter(s => s.subjectType === 'Lab')
                  .forEach(sub => { %>
                <div class="col-sm-6 col-md-4">
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="labSubjectIds[]" value="<%=sub._id%>">
                    <label class="form-check-label"><%=sub.subjectName%></label>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>

          <button type="submit" class="btn btn-success">
            <i class="bi bi-check-lg"></i> Save Room
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Existing Rooms -->
  <% infrastructures.forEach(inf => {
       const deptNames = inf.departmentIds.map(d => d.departmentName);
       const clsNames  = inf.classIds.map(c => c.className);
       const labNames  = inf.labSubjectIds.map(s => s.subjectName);
  %>
    <div class="card mb-3 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h5>
              Room <%=inf.roomNo%>
              <small class="text-muted">(<%=inf.type%>)</small>
            </h5>
            <p><strong>Departments:</strong>
               <%= deptNames.length ? deptNames.join(', ') : 'None' %>
            </p>
            <p><strong>Classes:</strong>
               <%= clsNames.length ? clsNames.join(', ') : 'None' %>
            </p>
            <% if (inf.type==='lab') { %>
              <p><strong>Lab Subjects:</strong>
                 <%= labNames.length ? labNames.join(', ') : 'None' %>
              </p>
            <% } %>
          </div>
          <div>
            <button class="btn btn-sm btn-warning mr-2"
                    data-toggle="collapse"
                    data-target="#editForm-<%=inf._id%>">
              Edit
            </button>
            <form action="/infrastructure/delete/<%=inf._id%>?_method=DELETE"
                  method="POST" class="d-inline">
              <button class="btn btn-sm btn-danger">Delete</button>
            </form>
          </div>
        </div>

        <!-- Edit Form -->
        <div id="editForm-<%=inf._id%>" class="collapse mt-3">
          <div class="card border-secondary">
            <div class="card-body">
              <form action="/infrastructure/<%=inf._id%>?_method=PUT" method="POST">
                <div class="form-row">
                  <div class="form-group col-md-6">
                    <label>Room No</label>
                    <input type="text" name="roomNo" class="form-control"
                           value="<%=inf.roomNo%>" required>
                  </div>
                  <div class="form-group col-md-6">
                    <label>Type</label>
                    <select name="type" class="form-control"
                            onchange="toggleEditLabSubjects('<%=inf._id%>')">
                      <option value="classroom" <%=inf.type==='classroom'?'selected':''%>>
                        Classroom
                      </option>
                      <option value="lab" <%=inf.type==='lab'?'selected':''%>>
                        Lab
                      </option>
                    </select>
                  </div>
                </div>

                <!-- Departments -->
                <div class="form-group">
                  <label class="font-weight-bold">Departments</label>
                  <div class="row">
                    <% departments.forEach(dept => { %>
                      <div class="col-sm-6 col-md-4">
                        <div class="form-check">
                          <input class="form-check-input" type="checkbox"
                                 name="departmentIds[]"
                                 value="<%=dept._id%>"
                                 <%= inf.departmentIds.some(d=>d._id.equals(dept._id))?'checked':'' %>>
                          <label class="form-check-label"><%=dept.departmentName%></label>
                        </div>
                      </div>
                    <% }) %>
                  </div>
                </div>

                <!-- Classes -->
                <div class="form-group">
                  <label class="font-weight-bold">Classes</label>
                  <div class="row">
                    <% classes.forEach(cls => { %>
                      <div class="col-sm-6 col-md-4">
                        <div class="form-check">
                          <input class="form-check-input" type="checkbox"
                                 name="classIds[]"
                                 value="<%=cls._id%>"
                                 <%= inf.classIds.some(c=>c._id.equals(cls._id))?'checked':'' %>>
                          <label class="form-check-label"><%=cls.className%></label>
                        </div>
                      </div>
                    <% }) %>
                  </div>
                </div>

                <!-- Lab Subjects -->
                <div id="editLabSubjectsDiv-<%=inf._id%>" class="form-group"
                     style="<%=inf.type==='lab'?'display:block;':'display:none;'%>">
                  <label class="font-weight-bold">Lab Subjects</label>
                  <div class="row">
                    <% subjects.filter(s=>s.subjectType==='Lab').forEach(sub => { %>
                      <div class="col-sm-6 col-md-4">
                        <div class="form-check">
                          <input class="form-check-input" type="checkbox"
                                 name="labSubjectIds[]"
                                 value="<%=sub._id%>"
                                 <%= inf.labSubjectIds.some(l=>l.equals(sub._id))?'checked':''%>>
                          <label class="form-check-label"><%=sub.subjectName%></label>
                        </div>
                      </div>
                    <% }) %>
                  </div>
                </div>

                <button type="submit" class="btn btn-success">
                  <i class="bi bi-check-lg"></i> Save Changes
                </button>
              </form>
            </div>
          </div>
        </div>
        <!-- /Edit Form -->

      </div>
    </div>
  <% }) %>

</div>

<script>
  function toggleAddLabSubjects() {
    document.getElementById('addLabSubjectsDiv').style.display =
      document.getElementById('addType').value === 'lab' ? 'block' : 'none';
  }
  function toggleEditLabSubjects(id) {
    document.getElementById(`editLabSubjectsDiv-${id}`).style.display =
      document.querySelector(`#editForm-${id} select[name="type"]`)
              .value === 'lab'
        ? 'block'
        : 'none';
  }
</script>

<%- include('../layout/footer') %>