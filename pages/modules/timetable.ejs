<%- include('../layout/header') %>

<div class="container mt-5">

  <!-- ========== Export Button ========== -->
  <div class="d-flex justify-content-end mb-4">
    <a 
      href="http://localhost:8000/export-timetables?departmentId=<%= departmentId %>&academicYearId=<%= academicYearId %>"
      class="btn btn-success"
      role="button"
    >
      <i class="bi bi-file-earmark-spreadsheet"></i> Export All Timetables
    </a>
  </div>

  <!-- ========== Batch Timetables Section ========== -->
  <h1 class="mb-4 text-center">
    Batch Timetables: <%= academicYearName %> – <%= departmentName %>
  </h1>

  <% if (!schedules || !schedules.length) { %>
    <div class="alert alert-warning text-center">
      No timetables available for this department and academic year.
    </div>
  <% } %>

  <% schedules.forEach(function(sch) { %>
    <div class="card mb-5 shadow-sm">
      <div class="card-header bg-primary text-white">
        <h3 class="mb-0">Class: <%= sch.className %></h3>
      </div>
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-bordered table-striped table-hover align-middle text-center mb-0">
            <thead class="table-dark">
              <tr>
                <th scope="col">Slot / Day</th>
                <% 
                  // Extract the day‐keys from sch.schedule (e.g. ["Monday","Tuesday",…])
                  const days = Object.keys(sch.schedule || {});
                  days.forEach(function(day) { 
                %>
                  <th scope="col"><%= day %></th>
                <% }); %>
              </tr>
            </thead>
            <tbody>
              <% 
                if (days && days.length) {
                  const numSlots = sch.schedule[days[0]].length;
                  for (let si = 0; si < numSlots; si++) { 
              %>
                <tr>
                  <th scope="row" class="text-start">Slot <%= si + 1 %></th>
                  <% days.forEach(function(day) {
                       const slot = sch.schedule[day][si];
                  %>
                    <td>
                      <% 
                        // CASE A: If it's an Array (i.e. a lab block) and has length
                        if (Array.isArray(slot) && slot.length) { 
                      %>
                        <% slot.forEach(function(entry, idx) { %>
                          <div class="mb-1">
                            <span class="badge bg-info text-dark me-1"><%= entry.batch || '' %></span>
                            <strong><%= entry.subject %></strong>
                          </div>
                          <div>
                            <small class="text-muted"><%= entry.teacher %> (<%= entry.room %>)</small>
                          </div>
                          <% if (idx < slot.length - 1) { %>
                            <hr class="my-1">
                          <% } %>
                        <% }); %>

                      <% 
                        // CASE B: If it's a single‐lecture object (has .subject)
                        } else if (slot && slot.subject) { 
                      %>
                        <strong><%= slot.subject %></strong><br>
                        <small class="text-muted"><%= slot.teacher %> (<%= slot.room %>)</small>

                      <% 
                        // CASE C: Everything else (this only happens if somehow slot is still null/undefined)
                        } else { 
                      %>
                        <span class="text-muted">FREE</span>
                      <% } %>
                    </td>
                  <% }); %>
                </tr>
              <%    
                  } // end for(si)
                } // end if(days)
              %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% }); %>


  <!-- ========== Professor’s Timetables Section ========== -->
  <h1 class="mb-4 text-center">Professor’s Timetables</h1>

  <% if (!profTables || !profTables.length) { %>
    <div class="alert alert-info text-center">
      No professor timetables to display.
    </div>
  <% } %>

  <% profTables.forEach(function(pt) { %>
    <div class="card mb-5 shadow-sm">
      <div class="card-header bg-success text-white">
        <h3 class="mb-0">
          Professor:&nbsp;
          <% 
            // Capitalize each word in profName:
            const parts = pt.profName.split(" ");
            const fancy = parts.map(p => p.charAt(0).toUpperCase() + p.slice(1)).join(" ");
          %>
          <%= fancy %>
        </h3>
      </div>
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-bordered table-striped table-hover align-middle text-center mb-0">
            <thead class="table-dark">
              <tr>
                <th scope="col">Slot / Day</th>
                <% 
                  const daysP = Object.keys(pt.schedule || {});
                  daysP.forEach(function(day) {
                %>
                  <th scope="col"><%= day %></th>
                <% }); %>
              </tr>
            </thead>
            <tbody>
              <% 
                if (daysP && daysP.length) {
                  const numSlotsP = pt.schedule[daysP[0]].length;
                  for (let si = 0; si < numSlotsP; si++) {
              %>
                <tr>
                  <th scope="row" class="text-start">Slot <%= si + 1 %></th>
                  <% daysP.forEach(function(day) {
                       const slot = pt.schedule[day][si];
                  %>
                    <td>
                      <% if (slot && slot.subject) { %>
                        <strong><%= slot.subject %></strong><br>
                        <small class="text-muted">
                          Class: <%= slot.class %>
                          <% if (slot.batch) { %>
                            (Batch: <%= slot.batch %>)
                          <% } %>
                          <br>
                          Room: <%= slot.room %>
                        </small>
                      <% } else { %>
                        <!-- PROFESSOR fallback: show Free -->
                        <span class="text-muted">Free</span>
                      <% } %>
                    </td>
                  <% }); %>
                </tr>
              <% 
                  } // end for(si)
                } // end if(daysP)
              %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% }); %>

</div>

<%- include('../layout/footer') %>