<%- include('../layout/header') %>

<div class="container mt-5">
  <h2 class="text-center mb-4">Generated Timetable</h2>
  <div class="table-responsive">
    <table class="table table-bordered table-striped table-hover">
      <thead class="thead-dark">
        <tr>
          <th style="width: 80px;">Slot</th>
          <th>Monday</th>
          <th>Tuesday</th>
          <th>Wednesday</th>
          <th>Thursday</th>
          <th>Friday</th>
        </tr>
      </thead>
      <tbody>
        <% for (let i = 0; i < 6; i++) { %>
          <tr>
            <td class="text-center align-middle">Slot <%= i + 1 %></td>
            <% ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"].forEach(day => { %>
              <td class="align-middle">
                <% 
                  // Get the slot value for the day
                  const slotVal = timetable[day] ? timetable[day][i] : null; 
                %>
                <% if (!slotVal) { %>
                  <span class="text-muted">-</span>
                <% } else if (typeof slotVal === "object") { 
                     // If this is a lecture object (has a 'subject' property) vs a lab session object.
                     if (slotVal.subject) { 
                %>
                  <div><strong><%= slotVal.subject %></strong></div>
                  <div><small><%= slotVal.teacher %> | Room: <%= slotVal.room %></small></div>
                <% } else { %>
                  <% Object.keys(slotVal).forEach(batch => { %>
                    <div class="mb-1 p-1 border rounded bg-light">
                      <strong><%= batch %>:</strong>
                      <span><%= slotVal[batch].subject %></span>
                      <br>
                      <small><%= slotVal[batch].teacher %> | Room: <%= slotVal[batch].room %></small>
                    </div>
                  <% }); %>
                <% } %>
                <% } else { %>
                  <%= slotVal %>
                <% } %>
              </td>
            <% }); %>
          </tr>
        <% } %>
      </tbody>
    </table>
    
  </div>
</div>

<%- include('../layout/footer') %>
