<%- include('../layout/header') %>

<div class="container mt-5">

  <!-- ========== Export Button & Save Button ========== -->
  <div class="d-flex justify-content-between mb-4">
    <a 
      href="http://localhost:8000/export-timetables?departmentId=<%= departmentId %>&academicYearId=<%= academicYearId %>"
      class="btn btn-success"
      role="button"
    >
      <i class="bi bi-file-earmark-spreadsheet"></i> Export All Timetables
    </a>

    <!-- Save Timetables Button -->
    <button id="saveBtn" class="btn btn-primary">
      <i class="bi bi-save"></i> Save Timetables
    </button>
  </div>

  <!-- ========== Batch Timetables Section ========== -->
  <h1 class="mb-4 text-center">
    Batch Timetables: <%= academicYearName %> – <%= departmentName %>
  </h1>

  <% if (!schedules || schedules.length === 0) { %>
    <div class="alert alert-warning text-center">
      No class timetables available for this department and academic year.
    </div>
  <% } else { %>
    <% 
      // We assume `schedules` is an array of objects:
      //   { classId, className, schedule: { Monday: [...], Tuesday: [...], … } }
      const days = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"];
    %>
    <% schedules.forEach(function(classObj) { %>
      <div class="card mb-5 shadow-sm">
        <div class="card-header bg-primary text-white">
          <h3 class="mb-0">Class: <%= classObj.className %></h3>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover align-middle text-center mb-0">
              <thead class="table-dark">
                <tr>
                  <th scope="col">Slot / Day</th>
                  <% days.forEach(function(day) { %>
                    <th scope="col"><%= day %></th>
                  <% }); %>
                </tr>
              </thead>
              <tbody>
                <% 
                  // Determine how many slots by checking the length of one day’s array
                  const numSlots = (classObj.schedule[days[0]] || []).length;
                  for (let slotIndex = 0; slotIndex < numSlots; slotIndex++) { 
                %>
                  <tr>
                    <th scope="row" class="text-start">Slot <%= slotIndex + 1 %></th>
                    <% days.forEach(function(day) {
                         // Get the “cell” for this day+slot. Could be:
                         //   • an Array (lab block) 
                         //   • an Object with `.subject` (single lecture) 
                         //   • null
                         const slotCell = (classObj.schedule[day] || [])[slotIndex];
                    %>
                      <td>
                        <% if (Array.isArray(slotCell) && slotCell.length > 0) { %>
                          <!-- CASE 1: Lab‐block (array of session objects) -->
                          <% slotCell.forEach(function(entry, idx) { %>
                            <div class="mb-1">
                              <% if (entry.batch) { %>
                                <span class="badge bg-info text-dark me-1"><%= entry.batch %></span>
                              <% } %>
                              <strong><%= entry.subject %></strong>
                            </div>
                            <div>
                              <small class="text-muted">
                                <%= entry.teacher %> (<%= entry.room %>)
                              </small>
                            </div>
                            <% if (idx < slotCell.length - 1) { %>
                              <hr class="my-1">
                            <% } %>
                          <% }); %>

                        <% } else if (slotCell && slotCell.subject) { %>
                          <!-- CASE 2: Single lecture/MOOC object -->
                          <strong><%= slotCell.subject %></strong><br>
                          <small class="text-muted">
                            <%= slotCell.teacher %> (<%= slotCell.room %>)
                          </small>

                        <% } else { %>
                          <!-- CASE 3: Free slot -->
                          <span class="text-muted">FREE</span>
                        <% } %>
                      </td>
                    <% }); %>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    <% }); %>
  <% } %>

  <!-- ========== Professor’s Timetables Section ========== -->
  <h1 class="mb-4 text-center">Professor’s Timetables</h1>

  <% if (!profTables || profTables.length === 0) { %>
    <div class="alert alert-info text-center">
      No professor timetables to display.
    </div>
  <% } else { %>
    <% 
      // Each `pt` has { teacherId, teacherName, schedule: { Monday: [...], … } }
      const profDays = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"];
    %>
    <% profTables.forEach(function(pt) { %>
      <div class="card mb-5 shadow-sm">
        <div class="card-header bg-success text-white">
          <h3 class="mb-0">
            Professor:&nbsp;
            <% 
              // Capitalize each word in pt.teacherName
              const parts = (pt.profName || "").split(" ");
              const capitalName = parts.map(p => p.charAt(0).toUpperCase() + p.slice(1)).join(" ");
            %>
            <%= capitalName %>
          </h3>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover align-middle text-center mb-0">
              <thead class="table-dark">
                <tr>
                  <th scope="col">Slot / Day</th>
                  <% profDays.forEach(function(day) { %>
                    <th scope="col"><%= day %></th>
                  <% }); %>
                </tr>
              </thead>
              <tbody>
                <% 
                  // Determine number of slots by checking length of any day's array
                  const numProfSlots = (pt.schedule[profDays[0]] || []).length;
                  for (let slotIndex = 0; slotIndex < numProfSlots; slotIndex++) {
                %>
                  <tr>
                    <th scope="row" class="text-start">Slot <%= slotIndex + 1 %></th>
                    <% profDays.forEach(function(day) {
                         // Fetch the professor’s cell: could be an Array, an Object, or null
                         const profCell = (pt.schedule[day] || [])[slotIndex];
                    %>
                      <td>
                        <% if (!profCell) { %>
                          <!-- Prof is free -->
                          <span class="text-muted">Free</span>

                        <% } else if (profCell.subject) { %>
                          <!-- Single lecture or MOOC object -->
                          <div>
                            <strong><%= profCell.subject %></strong><br>
                            <small class="text-muted">
                              Class: <%= profCell.className %><br>
                              Room: <%= profCell.room %>
                            </small>
                          </div>

                        <% } else if (Array.isArray(profCell) && profCell.length > 0) { %>
                          <!-- Lab block (array of entries) -->
                          <% profCell.forEach(function(item, idx) { %>
                            <div class="mb-1">
                              <% if (item.batch) { %>
                                <span class="badge bg-info text-dark me-1"><%= item.batch %></span>
                              <% } %>
                              <strong><%= item.subject %></strong>
                            </div>
                            <div>
                              <small class="text-muted">
                                Class: <%= item.className %><br>
                                Room: <%= item.room %>
                              </small>
                            </div>
                            <% if (idx < profCell.length - 1) { %>
                              <hr class="my-1">
                            <% } %>
                          <% }); %>
                        <% } else { %>
                          <!-- Fallback, treat as free -->
                          <span class="text-muted">Free</span>
                        <% } %>
                      </td>
                    <% }); %>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    <% }); %>
  <% } %>

</div>

<%- include('../layout/footer') %>

<script>
  // POST all current data back to /timetable/save-generated
  document.getElementById("saveBtn").addEventListener("click", function() {
    fetch("/timetable/save-generated", {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        departmentId: "<%= departmentId %>",
        academicYearId: "<%= academicYearId %>",
        departmentName: "<%= departmentName %>",
        academicYearName: "<%= academicYearName %>",
        schedules: <%- JSON.stringify(schedules) %>,
        profTables: <%- JSON.stringify(profTables) %>
      })
    })
    .then(res => res.json())
    .then(data => {
      if (data.message) {
        alert(data.message);
      } else {
        alert("Timetables saved successfully.");
      }
    })
    .catch(err => {
      console.error(err);
      alert("Error saving timetables. Check console.");
    });
  });
</script>