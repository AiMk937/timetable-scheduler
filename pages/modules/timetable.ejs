<%- include('../layout/header') %>

<div class="container mt-5">
  <h1 class="mb-4 text-center">Batch Timetables</h1>

  <% if (!schedules.length) { %>
    <div class="alert alert-warning text-center">
      No timetables available for this department and academic year.
    </div>
  <% } %>

  <% schedules.forEach(function(sch) { %>
    <div class="card mb-5 shadow-sm">
      <div class="card-header bg-primary text-white">
        <h3 class="mb-0">Class: <%= sch.className %></h3>
      </div>
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-bordered table-striped table-hover align-middle text-center mb-0">
            <thead class="table-dark">
              <tr>
                <th scope="col">Slot / Day</th>
                <% const days = Object.keys(sch.schedule); days.forEach(function(day) { %>
                  <th scope="col"><%= day %></th>
                <% }); %>
              </tr>
            </thead>
            <tbody>
              <% 
                const days2 = Object.keys(sch.schedule);
                const numSlots = sch.schedule[days2[0]].length;
                for (let si = 0; si < numSlots; si++) { 
              %>
                <tr>
                  <th scope="row" class="text-start">Slot <%= si+1 %></th>
                  <% days2.forEach(function(day) {
                       const slot = sch.schedule[day][si];
                  %>
                    <td>
                      <% if (Array.isArray(slot) && slot.length) { %>
                        <% slot.forEach(function(entry, idx) { %>
                          <div class="mb-1">
                            <span class="badge bg-info text-dark me-1"><%= entry.batch || '' %></span>
                            <strong><%= entry.subject %></strong>
                          </div>
                          <div>
                            <small class="text-muted"><%= entry.teacher %> (<%= entry.room %>)</small>
                          </div>
                          <% if (idx < slot.length - 1) { %>
                            <hr class="my-1">
                          <% } %>
                        <% }); %>
                      <% } else if (slot && slot.subject) { %>
                        <strong><%= slot.subject %></strong><br>
                        <small class="text-muted"><%= slot.teacher %> (<%= slot.room %>)</small>
                      <% } else { %>
                        <span class="text-muted">Free</span>
                      <% } %>
                    </td>
                  <% }); %>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% }); %>
</div>

<%- include('../layout/footer') %>